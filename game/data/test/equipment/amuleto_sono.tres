[gd_resource type="Resource" script_class="EquipmentDef" format=3]

[ext_resource type="Script" path="res://core/defs/stats.gd" id="stats"]
[ext_resource type="Script" path="res://core/defs/equipment_def.gd" id="def"]
[ext_resource type="Script" path="res://core/defs/equipment_passive.gd" id="pscript"]
[ext_resource type="Resource" path="res://data/test/statuses/sleep.tres" id="st_sleep"]

[sub_resource type="Resource" id="stats_1"]
script = ExtResource("stats")
strength = 0
speed = 0
vitality = 0
aura = 0

[sub_resource type="Resource" id="passive_1"]
script = ExtResource("pscript")
kind = 0
status = ExtResource("st_sleep")

[resource]
script = ExtResource("def")
id = &"amuleto_sono"
display_name = "Amuleto Anti-Sono"
slot = &"accessory"
modifiers = SubResource("stats_1")
passives = Array[ExtResource("pscript")]([SubResource("passive_1")])
