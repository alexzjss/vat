[gd_resource type="Resource" script_class="EventScript" format=3]

[ext_resource type="Script" path="res://core/events/event_script.gd" id="1_eventscr"]
[ext_resource type="Script" path="res://core/events/event_step.gd" id="2_eventste"]
[ext_resource type="Script" path="res://core/events/if_flag_step.gd" id="3_ifflagst"]
[ext_resource type="Script" path="res://core/events/say_step.gd" id="4_saystep"]
[ext_resource type="Resource" path="res://data/fatia/heroes/teste_d_f.tres" id="5_tested"]
[ext_resource type="Script" path="res://core/events/recruit_step.gd" id="6_recruits"]
[ext_resource type="Script" path="res://core/events/set_flag_step.gd" id="7_setflags"]
[ext_resource type="Script" path="res://core/events/goto_step.gd" id="8_gotostep"]
[ext_resource type="Script" path="res://core/events/label_step.gd" id="9_labelste"]

[sub_resource type="Resource" id="s1"]
script = ExtResource("3_ifflagst")
flag = &"recrutado_d"
op = 0
value = 0
else_label = &"ja"

[sub_resource type="Resource" id="s2"]
script = ExtResource("4_saystep")
speaker = "Teste D"
text = "Texto de teste: posso me juntar ao grupo."

[sub_resource type="Resource" id="s3"]
script = ExtResource("6_recruits")
hero = ExtResource("5_tested")
level_mode = 0

[sub_resource type="Resource" id="s4"]
script = ExtResource("7_setflags")
flag = &"recrutado_d"
value = 1

[sub_resource type="Resource" id="s5"]
script = ExtResource("8_gotostep")
label = &"fim"

[sub_resource type="Resource" id="s6"]
script = ExtResource("9_labelste")
label_name = &"ja"

[sub_resource type="Resource" id="s7"]
script = ExtResource("4_saystep")
speaker = "Teste D"
text = "Texto de teste: já estou no grupo."

[sub_resource type="Resource" id="s8"]
script = ExtResource("9_labelste")
label_name = &"fim"

[resource]
script = ExtResource("1_eventscr")
steps = Array[ExtResource("2_eventste")]([SubResource("s1"), SubResource("s2"), SubResource("s3"), SubResource("s4"), SubResource("s5"), SubResource("s6"), SubResource("s7"), SubResource("s8")])
